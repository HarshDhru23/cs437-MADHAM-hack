# CoursePath environment variable NAMES. Copy nothing real into this file or Git.
# Settings read the process environment directly (server/config/settings.py);
# a local run needs none of these. Details: docs/operations/runbook.md §2.

# Production mode only (not used on localhost): production | development (default development: DEBUG on, local SQLite)
COURSEPATH_ENV=
# Required in production. Generate on the host; never commit.
COURSEPATH_SECRET_KEY=
# Comma-separated host names. Not needed on localhost (default localhost,127.0.0.1,testserver).
COURSEPATH_ALLOWED_HOSTS=
# Google sign-in for IITGN accounts only (D-46). The OAuth client ID is public. While it is set, password sign-up and sign-in are off.
COURSEPATH_GOOGLE_CLIENT_ID=
# Set to 1 to keep password sign-in (never sign-up) for accounts made before Google sign-in.
# COURSEPATH_ALLOW_PASSWORD_LOGIN=

# PostgreSQL connection (production, or development with COURSEPATH_DB_ENGINE=postgresql).
COURSEPATH_DB_NAME=
COURSEPATH_DB_USER=
COURSEPATH_DB_PASSWORD=
COURSEPATH_DB_HOST=
COURSEPATH_DB_PORT=5432
# Development/CI only.
# COURSEPATH_DB_ENGINE=postgresql
# COURSEPATH_SQLITE_PATH=
# Vite dev/preview proxy target.
# COURSEPATH_API_ORIGIN=http://127.0.0.1:8000
